DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"
PORT=3001
BETTER_AUTH_SECRET=random-secret
BETTER_AUTH_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
NODE_ENV="development"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-with-a-long-random-token"
META_APP_SECRET="replace-with-your-meta-app-secret"
WHATSAPP_ACCESS_TOKEN="replace-with-your-system-user-or-test-token"
META_GRAPH_API_VERSION="v26.0"
# ai
SARVAM_API_KEY="replace-with-your-sarvam-api-key"
SARVAM_MODEL="sarvam-105b-conversations"
SARVAM_BASE_URL="https://api.sarvam.ai"
OPENAI_API_KEY="replace-with-your-openai-api-key"
OPENAI_MODEL="gpt-5-mini"
AI_REQUEST_TIMEOUT_MS="12000"
AI_AUTO_REPLY_ENABLED="false"
